# OS
.DS_Store

# Rust
target/

# Build artifacts — never commit compiled binaries
*.dylib
*.a
*.o
*.dSYM/

# Generated code (re-create with swift-bridge-gen)
generated/

# Generated snapshots
**/snapshots/*.png

# Temp analysis files
/tmp/swiftui_analysis/

# Swift build caches (generated by swift-helper-build)
**/.swift-cache/
*.rlib
*.swiftmodule
*.swiftdoc
*.swiftsourceinfo
*.abi.json
APPLE_PLATFORMS_PROTOTYPE.rs
